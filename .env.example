# AurumMind AI - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# Data Sources
DATA_SOURCE=Dukascopy
INSTRUMENT=XAUUSD

# Database (for future phases)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=aurummind
# POSTGRES_USER=aurummind
# POSTGRES_PASSWORD=your_password_here

# MLflow (for future phases)
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=aurummind_experiments

# API Keys (for future phases - external data providers)
# API_KEY_PROVIDER_1=your_api_key_here
